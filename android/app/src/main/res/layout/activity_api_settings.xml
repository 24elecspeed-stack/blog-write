<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API 키 설정"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="네이버 검색광고 API"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/linkSearchAdKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="발급 페이지"
                android:textColor="@color/primary"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp" />
            <TextView
                android:id="@+id/guideSearchAdKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="발급 설명서"
                android:textColor="@color/accent"
                android:textStyle="bold" />
        </LinearLayout>
        <EditText android:id="@+id/inputSearchAdApiKey" android:hint="API Key(액세스라이선스)"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/inputSearchAdSecretKey" android:hint="Secret Key"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/inputSearchAdCustomerId" android:hint="CUSTOMER_ID"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="네이버 오픈API"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/linkOpenApiKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="발급 페이지"
                android:textColor="@color/primary"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp" />
            <TextView
                android:id="@+id/guideOpenApiKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="발급 설명서"
                android:textColor="@color/accent"
                android:textStyle="bold" />
        </LinearLayout>
        <EditText android:id="@+id/inputOpenApiClientId" android:hint="Client ID"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/inputOpenApiClientSecret" android:hint="Client Secret"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gemini API (AI 글 초안 생성용)"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/linkGeminiKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="발급 페이지"
                android:textColor="@color/primary"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp" />
            <TextView
                android:id="@+id/guideGeminiKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="발급 설명서"
                android:textColor="@color/accent"
                android:textStyle="bold" />
        </LinearLayout>
        <EditText android:id="@+id/inputGeminiApiKey"
            android:hint="Gemini API Key (여러 개면 한 줄에 하나씩 입력 - 할당량 소진 시 자동으로 다음 키로 전환됩니다)"
            android:inputType="textMultiLine" android:minLines="2"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button
            android:id="@+id/btnAddGeminiKey"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="+ 키 추가" />

        <Button
            android:id="@+id/btnSaveKeys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="저장" />
    </LinearLayout>
</ScrollView>
