<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/rootScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/surface" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Keyword Studio" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="네이버 콘텐츠 워크스페이스" android:textColor="@color/text_secondary" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/appVersionBadge" android:layout_width="wrap_content" android:layout_height="22dp" android:background="@drawable/studio_badge" android:gravity="center" android:paddingHorizontal="10dp" android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/btnUsageGuide" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="6dp" android:background="@drawable/studio_badge" android:clickable="true" android:focusable="true" android:gravity="center" android:paddingHorizontal="10dp" android:text="사용법" android:textColor="@color/primary_dark" android:textSize="12sp" android:textStyle="bold" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="0dp" android:paddingBottom="0dp" android:layout_weight="1">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="빠른 도구" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="0dp" android:orientation="vertical" android:layout_weight="1">
      <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="horizontal" android:layout_marginTop="6dp" android:baselineAligned="false" android:layout_weight="1">
        <LinearLayout android:id="@+id/btnOpenKeywordAnalysis" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/home_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
          <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/home_icon_bg">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_studio_chart" android:layout_gravity="center" android:tint="@color/accent" />
          </FrameLayout>
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="키워드 분석" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnOpenKeywordSearch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/home_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
          <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/home_icon_bg">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_studio_search" android:layout_gravity="center" android:tint="@color/accent" />
          </FrameLayout>
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="경쟁 글 검색" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:layout_weight="1" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp" android:orientation="horizontal" android:baselineAligned="false" android:layout_weight="1">
        <LinearLayout android:id="@+id/btnOpenRelatedKeyword" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/home_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
          <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/home_icon_bg">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_studio_link" android:layout_gravity="center" android:tint="@color/accent" />
          </FrameLayout>
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="연관 키워드" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnOpenBlogTitle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/home_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
          <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/home_icon_bg">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_studio_title" android:layout_gravity="center" android:tint="@color/accent" />
          </FrameLayout>
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="블로그 검증" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:layout_weight="1" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp" android:orientation="horizontal" android:baselineAligned="false" android:layout_weight="1">
        <LinearLayout android:id="@+id/btnOpenLowCompetitionDong" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/home_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
          <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/home_icon_bg">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_studio_place" android:layout_gravity="center" android:tint="@color/accent" />
          </FrameLayout>
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="지역 찾기" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnOpenApiSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/home_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
          <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/home_icon_bg">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_studio_settings" android:layout_gravity="center" android:tint="@color/accent" />
          </FrameLayout>
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="API 설정" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:layout_weight="1" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
      <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/home_card" android:orientation="horizontal" android:padding="6dp" android:gravity="center_vertical">
          <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="블로그" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:paddingStart="6dp" />
          <Spinner android:id="@+id/blogSpinner" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginTop="0dp" android:background="@drawable/studio_field" android:paddingHorizontal="0dp" android:layout_weight="1" />
          <TextView android:id="@+id/btnEditBlogPhones" android:layout_width="wrap_content" android:layout_height="48dp" android:clickable="true" android:focusable="true" android:padding="2dp" android:text="관리 ›" android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold" android:gravity="center" android:paddingHorizontal="10dp" />
        </LinearLayout>
      </FrameLayout>
      <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/home_card" android:orientation="horizontal" android:padding="6dp" android:gravity="center_vertical">
          <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="스타일" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:paddingStart="6dp" />
          <Spinner android:id="@+id/styleSpinner" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginTop="0dp" android:background="@drawable/studio_field" android:paddingHorizontal="0dp" android:layout_weight="1" />
        </LinearLayout>
      </FrameLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/btnOpenKeywordCaseInfo" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:background="@drawable/home_card" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp" android:padding="10dp">
      <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
        <View android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/icon_accent_circle" />
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:src="@drawable/ic_studio_chart" android:tint="@color/accent" />
      </FrameLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="키워드와 현장 정보" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/btnOpenRichCopyTest" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="8dp" android:background="@drawable/studio_hero" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp" android:padding="10dp">
      <FrameLayout android:layout_width="36dp" android:layout_height="36dp">
        <LinearLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/home_card" android:gravity="center" android:padding="0dp">
          <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_studio_photo" />
        </LinearLayout>
      </FrameLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="블로그 반자동 복사" android:textColor="@android:color/white" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="글쓰기·사진 배치·네이버 붙여넣기" android:textColor="#CFE0FF" android:textSize="12sp" />
      </LinearLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="›" android:textColor="@android:color/white" android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>