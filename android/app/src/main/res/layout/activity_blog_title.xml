<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="블로그 검색 검증"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ 이미 등록한 글은 본문·사진을 절대 수정하지 마세요. 발행 후 편집은 어뷰징으로 의심받아 검색 노출에 불리할 수 있습니다. 바꿔볼 필요가 있는 내용은 기존 글을 고치지 말고 새 글로 작성하세요."
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#C0392B"
            android:padding="10dp"
            android:background="#FDECEA"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <EditText
                android:id="@+id/inputBlogId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="블로그 ID (예: powerelecgo)" />
            <Button
                android:id="@+id/btnExtractTitles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="제목 추출" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="직접 입력한 키워드로 확인 (선택)"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />
        <EditText
            android:id="@+id/inputCheckKeywords"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:hint="확인할 키워드 (한 줄에 하나씩, 최대 10개) - 블로그 ID를 먼저 입력해주세요"
            android:layout_marginBottom="8dp" />
        <Button
            android:id="@+id/btnCheckKeywords"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="이 키워드들로 실제 검색 순위 확인"
            android:layout_marginBottom="8dp" />
        <LinearLayout
            android:id="@+id/keywordResultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnVerifyAllTitles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 전체 누락 자동 검증"
            android:layout_marginBottom="8dp" />
        <TextView
            android:id="@+id/blogTitleStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />
        <LinearLayout
            android:id="@+id/blogTitleResultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:layout_marginBottom="16dp" />

        <!-- 누락 검증(NaverRankChecker)용 숨김 WebView. 실제 검색결과 렌더링이 필요해서
             GONE이 아니라 1dp 크기로 붙여둔다(GONE이면 페이지가 제대로 그려지지 않음). -->
        <WebView
            android:id="@+id/hiddenWebView"
            android:layout_width="1dp"
            android:layout_height="1dp" />

    </LinearLayout>
</ScrollView>
