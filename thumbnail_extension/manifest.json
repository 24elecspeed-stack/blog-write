{
    "manifest_version": 3,
    "name": "블로그 대표사진 만들기",
    "version": "1.0",
    "description": "블로그 대표사진(썸네일)을 텍스트+이미지 조합으로 만드는 내부 도구",
    "permissions": [
        "storage",
        "scripting",
        "activeTab",
        "tabs",
        "clipboardRead",
        "clipboardWrite"
    ],
    "host_permissions": [
        "https://*.naver.com/*",
        "https://*.blog.me/*",
        "https://*.blog.naver.com/*"
    ],
    "web_accessible_resources": [
        {
            "resources": ["html2canvas.min.js", "icon.png", "HMKMRHD.TTF"],
            "matches": ["*://*/*"],
            "use_dynamic_url": true
        }
    ],
    "icons": {
        "16": "icon.png",
        "32": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "commands": {
        "open-popup": {
            "suggested_key": {
                "default": "Ctrl+Shift+Z",
                "mac": "Command+Shift+E"
            },
            "description": "썸네일 생성기 팝업 열기"
        }
    }
}
